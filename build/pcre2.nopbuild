[INFO]
name: pcre2
version: 10.49
source-url: https://codeload.github.com/PCRE2Project/pcre2/tar.gz/refs/tags/pcre2-10.49
source-sha256: 69d04dcddcf9e038aeae8f58b0c07ee5e08abb835ee8daa2bd6acee433dc112c

[BUILD]
./configure --prefix=/usr --enable-unicode --enable-jit --enable-pcre2-16 --enable-pcre2-32 --disable-static
make -j$(nproc)

[INSTALL]
make install DESTDIR=root
